@model List<TodoWebApplication.Models.Task>
@{
    ViewData["Title"] = "TODO List";
}
<h2 class="mt-4 mb-3 text-primary fw-bold">TODO List</h2>
<div class="card shadow-lg border-0 mb-4" style="background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fs-4 fw-semibold text-dark">
                <i class="bi bi-list-task text-primary"></i> Your Tasks
            </span>
            <a class="btn btn-success px-4" href="/Task/Create">
                <i class="bi bi-plus-circle"></i> Add Task
            </a>
        </div>
        <table class="table table-bordered table-striped align-middle bg-white rounded">
            <thead class="table-primary">
                <tr>
                    <th><i class="bi bi-hash"></i> ID</th>
                    <th><i class="bi bi-pencil"></i> Title</th>
                    <th><i class="bi bi-card-text"></i> Description</th>
                    <th><i class="bi bi-flag"></i> Priority</th>
                    <th><i class="bi bi-check2-square"></i> Status</th>
                    <th><i class="bi bi-gear"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No tasks available. Click "Add Task" to create one.</td>
                </tr>
            }
            else
            {
                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.Id</td>
                        <td>@task.Title</td>
                        <td>@task.Description</td>
                        <td>
                            <span class="badge 
                                @(task.Priority == TodoWebApplication.Models.TaskPriority.High ? "bg-danger" : 
                                  task.Priority == TodoWebApplication.Models.TaskPriority.Medium ? "bg-warning text-dark" : 
                                  "bg-info text-dark")">
                                @task.Priority
                            </span>
                        </td>
                        <td>
                            @if (task.IsCompleted)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Done</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-hourglass-split"></i> Pending</span>
                            }
                        </td>
                        <td>
                            @if (!task.IsCompleted)
                            {
                                <a class="btn btn-success btn-sm me-1" href="/Task/Complete/@task.Id">
                                    <i class="bi bi-check2"></i> Complete
                                </a>
                            }
                            <a class="btn btn-danger btn-sm" href="/Task/Delete/@task.Id">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
