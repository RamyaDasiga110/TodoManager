@{
    ViewData["Title"] = "Welcome";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);">
                <div class="card-body text-center">
                    <i class="bi bi-check2-circle display-1 text-primary mb-3"></i>
                    <h1 class="fw-bold text-dark mb-3">Welcome to TODO List Manager</h1>
                    <p class="lead text-dark mb-4">
                        Organize your tasks, set priorities, and stay productive with your colorful TODO app!
                    </p>
                    <a href="/Task" class="btn btn-success btn-lg px-4">
                        <i class="bi bi-list-task"></i> View Tasks
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
